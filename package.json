{
  "name": "bedrock-server-tool",
  "version": "1.14.0",
  "description": "Admin Suite - an all-in-one server management addon for Minecraft Bedrock",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "node build.mjs --package",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "test": "node test/smoke.mjs && node test/toggles.mjs",
    "docs": "node scripts/gen-docs.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@minecraft/server": "2.9.0",
    "@minecraft/server-ui": "2.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
